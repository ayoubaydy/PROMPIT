{
  "manifest_version": 3,
  "name": "Promp it",
  "version": "1.10.13",
  "description": "One-click vision analysis for any image: get a complete AI prompt with subject, pose, camera, lighting, composition, and style.",
  "homepage_url": "https://baydy.art",
  "author": "Baydy Art (https://baydy.art)",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "contextMenus",
    "declarativeNetRequestWithHostAccess",
    "downloads",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/prompit-16.png",
    "32": "icons/prompit-32.png",
    "48": "icons/prompit-48.png",
    "128": "icons/prompit-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Capture an area with Promp it",
    "default_icon": {
      "16": "icons/prompit-16.png",
      "32": "icons/prompit-32.png",
      "48": "icons/prompit-48.png",
      "128": "icons/prompit-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Capture an area and generate a prompt"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.css", "tokens.css", "PROMPIT_LOGO.svg"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{d3b6a055-60c5-4c77-873e-441d73b6d27e}",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    },
    "safari": {
      "strict_min_version": "16.4"
    }
  }
}
